# Vorlage fuer scripts/wberechnung-mysql-test.env (LOKAL, nicht versioniert).
# Kopieren nach scripts/wberechnung-mysql-test.env und Werte eintragen.
# Genutzt von scripts/wberechnung-mysql-check.sh.

# Pfad zur wberechnung-App (Herd):
WB_APP=/Users/yamanuri/Herd/wberechnung

# Isolierte MySQL-Test-DB (NIE eine ticket-DB):
WB_DB=wberechnung_mysql_test
WB_DB_HOST=localhost

# MySQL-Zugang mit Rechten auf WB_DB (ticket_user hat GRANT ALL darauf):
WB_DB_USER=ticket_user
WB_DB_PASS=DEIN_MYSQL_PASSWORT_HIER
