# Claude Code lokale Agenten-Config: maschinenspezifische Permission-Allowlist,
# kein geteilter Repo-Inhalt (kehrte bei jedem Commit als Rauschen zurueck).
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/

# stale git-lock-Artefakte der Parallel-Instanzen
